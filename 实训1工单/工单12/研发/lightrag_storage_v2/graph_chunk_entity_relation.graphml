    <node id="Package Transaction">
      <data key="d0">Package Transaction</data>
      <data key="d1">concept</data>
      <data key="d2">A package transaction refers to a series of transactions that are accounted for as a single transaction to obtain control.</data>
      <data key="d3">chunk-715426c8536b679514108da2caab6b17</data>
      <data key="d4">unknown_source</data>
