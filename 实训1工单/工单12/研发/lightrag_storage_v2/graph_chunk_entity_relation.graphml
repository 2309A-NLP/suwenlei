    <node id="国防单位">
      <data key="d0">国防单位</data>
      <data key="d1">organization</data>
      <data key="d2">国防单位是负责最终审定军品价格的机构，与公司存在审价合作关系。</data>
      <data key="d3">chunk-8455459f679507928ed432ed0eeb11a8</data>
