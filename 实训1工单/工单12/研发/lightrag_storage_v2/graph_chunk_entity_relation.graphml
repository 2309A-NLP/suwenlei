    <node id="12个月预期信用损失">
      <data key="d0">12个月预期信用损失</data>
      <data key="d1">concept</data>
      <data key="d2">12个月预期信用损失是公司按组合计量预期信用损失时参考的金额基准之一。</data>
      <data key="d3">chunk-36712d9113d14632f0fb71d06e864ed6</data>
