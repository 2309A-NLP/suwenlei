      <data key="d1">method</data>
      <data key="d2">端到端的半监督目标检测网络用于解决军事场景中目标训练数据不足条件下的模型训练问题，综合强监督和弱监督学习设计专门针对半监督学习的物体检测器网络结构。</data>
      <data key="d3">chunk-b39e1a4c83ac14c523892157386c1a4d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277860</data>
