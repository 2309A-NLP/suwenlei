      <data key="d1">concept</data>
      <data key="d2">销售商品收入在满足风险报酬转移等条件时确认。</data>
      <data key="d3">chunk-a54182f60d42d7ae398cdb80bfecd4e0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277863</data>
