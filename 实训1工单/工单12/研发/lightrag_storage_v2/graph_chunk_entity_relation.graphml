    </node>
    <node id="重大影响">
      <data key="d0">重大影响</data>
      <data key="d1">concept</data>
      <data key="d2">重大影响是指对被投资单位的财务和经营政策有参与决策的权力，但不能控制或共同控制这些政策的制定。</data>
      <data key="d3">chunk-e0d0ee3d0d23d40d115272270f54f621</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277860</data>
