    <node id="Aging Analysis">
      <data key="d0">Aging Analysis</data>
      <data key="d1">method</data>
      <data key="d2">Aging analysis is a method used to group accounts receivable by age for portfolio-based expected credit loss measurement.&lt;SEP&gt;Aging analysis is a method used to assess the recoverability of other receivables by categorizing balances by age and applying bad debt provision rates.</data>
      <data key="d3">chunk-2aa3063ca8148fef0d6b0b98a6b6e563&lt;SEP&gt;chunk-67a0e15a163891dc3165e7d1e9a9c5cf</data>
