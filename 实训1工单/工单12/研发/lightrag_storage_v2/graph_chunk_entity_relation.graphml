      <data key="d6" />
    </node>
    <node id="FPGA芯片">
      <data key="d0">FPGA芯片</data>
      <data key="d1">artifact</data>
      <data key="d2">FPGA芯片是用于烧录公司自研逻辑电路的硬件芯片，形成嵌入式硬件产品。</data>
      <data key="d3">chunk-58ff3d604c1665714873af9d99479266</data>
