    </node>
    <node id="投后6亿估值">
      <data key="d0">投后6亿估值</data>
      <data key="d1">concept</data>
      <data key="d2">投后6亿估值is the post-investment valuation of the company at 600 million yuan, used for equity calculation.&lt;SEP&gt;投后6亿估值is the post-investment valuation of the company at 600 million yuan, used to determine capital contributions.</data>
      <data key="d3">chunk-8720e7aa67adb2980b4973af48e4b91b&lt;SEP&gt;chunk-0f228f520bdad2789dde12421b268460</data>
      <data key="d4">unknown_source</data>
