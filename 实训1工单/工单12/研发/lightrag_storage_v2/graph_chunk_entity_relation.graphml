    <node id="Speculation">
      <data key="d0">Speculation</data>
      <data key="d1">concept</data>
      <data key="d2">Speculation over potential rate hikes is influencing market sentiment and investor behavior.&lt;SEP&gt;Speculation over potential rate hikes by the Federal Reserve influences market sentiment.&lt;SEP&gt;Speculation over potential rate hikes is influencing market dynamics.</data>
      <data key="d3">chunk-2be25df1af7e30c6a7392305cb22b52d&lt;SEP&gt;chunk-36712d9113d14632f0fb71d06e864ed6&lt;SEP&gt;chunk-a8b769f0b1dab26f09748ff9020c177a</data>
