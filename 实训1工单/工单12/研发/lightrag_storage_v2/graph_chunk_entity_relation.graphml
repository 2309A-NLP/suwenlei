    <node id="直接军方">
      <data key="d0">直接军方</data>
      <data key="d1">organization</data>
      <data key="d2">直接军方is the direct military customer that specifies procurement of the company's products through single-source methods.&lt;SEP&gt;直接军方refers to direct military customers who purchase products directly from the company.&lt;SEP&gt;直接军方refers to direct military customers of the company.</data>
      <data key="d3">chunk-41e6ef010bba2a819545e29f981f9a6a&lt;SEP&gt;chunk-14aa9b61d5d5a1090625ae2c5607e5b7&lt;SEP&gt;chunk-473e55c2e0de2133ac822000b79656bc</data>
