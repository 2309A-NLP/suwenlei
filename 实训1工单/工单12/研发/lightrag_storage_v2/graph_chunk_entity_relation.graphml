      <data key="d0">回款金额</data>
      <data key="d1">concept</data>
      <data key="d2">回款金额is the amount of payment collected, tracked up to September 30, 2019.</data>
      <data key="d3">chunk-06a8e0964a7d0c184c2475b3e18aba43</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780279097</data>
      <data key="d6" />
    </node>
    <node id="已回款">
      <data key="d0">已回款</data>
      <data key="d1">concept</data>
      <data key="d2">已回款is the amount already collected, which is 1.39亿元.</data>
      <data key="d3">chunk-06a8e0964a7d0c184c2475b3e18aba43</data>
