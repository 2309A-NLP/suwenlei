    <node id="信息披露管理制度">
      <data key="d0">信息披露管理制度</data>
      <data key="d1">content</data>
      <data key="d2">The信息披露管理制度is a document that specifies the principles, content, procedures, and responsibilities for information disclosure to ensure timely and accurate information for investors.</data>
      <data key="d3">chunk-735c1e7025b476d06d2968a85d58fc1d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780280181</data>
