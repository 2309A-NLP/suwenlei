      <data key="d6" />
    </node>
    <node id="G.711">
      <data key="d0">G.711</data>
      <data key="d1">concept</data>
      <data key="d2">G.711是一种由国际电信联盟制定的音频编码方式。&lt;SEP&gt;G.711是一种音频标准，被视音频综合服务平台兼容。</data>
      <data key="d3">chunk-014987a28aa1c57e58428f91364dc2ca&lt;SEP&gt;chunk-4d3373fcf196abd13ecb0324900615ac</data>
      <data key="d4">unknown_source</data>
