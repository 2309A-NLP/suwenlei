      <data key="d0">发出存货的计价方法</data>
      <data key="d1">method</data>
      <data key="d2">发出存货采用月末一次加权平均法进行计价。</data>
      <data key="d3">chunk-e0d0ee3d0d23d40d115272270f54f621</data>
      <data key="d4">unknown_source</data>
