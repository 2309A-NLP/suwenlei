    <node id="租赁费用">
      <data key="d0">租赁费用</data>
      <data key="d1">concept</data>
      <data key="d2">租赁费用是研发费用归集内容之一，包括研发场地租金。&lt;SEP&gt;租赁费用是研发费用的一部分，指研发部门外部租赁工作场地的租金。</data>
      <data key="d3">chunk-b25c1709d3d8634e2bf9aa86a05beec5&lt;SEP&gt;chunk-f202ac667cfc8976d9619692684e19e8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277868</data>
