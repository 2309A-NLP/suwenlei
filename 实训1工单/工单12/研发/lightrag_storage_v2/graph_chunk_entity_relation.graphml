      <data key="d1">concept</data>
      <data key="d2">让渡资产使用权收入在满足经济利益流入和收入可靠计量时确认。</data>
      <data key="d3">chunk-a54182f60d42d7ae398cdb80bfecd4e0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277863</data>
