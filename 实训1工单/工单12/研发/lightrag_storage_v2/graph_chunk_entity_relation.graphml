    <node id="业务独立">
      <data key="d0">业务独立</data>
      <data key="d1">concept</data>
      <data key="d2">业务独立是公司独立运营的一个方面，指公司拥有从事主营业务完整、独立的业务体系，能独立面对市场自主经营，且业务独立于控股股东、实际控制人及其控制的其他企业。</data>
      <data key="d3">chunk-450f069284fc5692d5ade6bb4aeb0deb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277844</data>
      <data key="d6" />
    </node>
    <node id="Goodwill">
      <data key="d0">Goodwill</data>
      <data key="d1">concept</data>
      <data key="d2">Goodwill is an intangible asset that arises when a buyer acquires an existing business, representing the excess of the purchase price over the fair value of the identifiable net assets.</data>
      <data key="d3">chunk-715426c8536b679514108da2caab6b17</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277844</data>
