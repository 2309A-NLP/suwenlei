    </node>
    <node id="用户认可">
      <data key="d0">用户认可</data>
      <data key="d1">concept</data>
      <data key="d2">用户认可是发行人在选择集成商时考量的因素，集成商需获得用户认可才能获取项目机会。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
