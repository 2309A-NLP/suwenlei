      <data key="d0">公司独立董事</data>
      <data key="d1">person</data>
      <data key="d2">Independent directors of the company who issued opinions on the fairness and necessity of related party transactions during the reporting period.</data>
      <data key="d3">chunk-507e2b6ca2f473187fea2747ef444ec5</data>
