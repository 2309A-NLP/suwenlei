    <node id="指挥控制设备">
      <data key="d0">指挥控制设备</data>
      <data key="d1">artifact</data>
      <data key="d2">指挥控制设备是指挥员对其所属部队实施指挥控制、进行管理时所用的设备、器材、程序的总称。</data>
      <data key="d3">chunk-014987a28aa1c57e58428f91364dc2ca</data>
