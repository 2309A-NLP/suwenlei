    <node id="发行人监事">
      <data key="d0">发行人监事</data>
      <data key="d1">person</data>
      <data key="d2">发行人监事是公司监事会的成员，出具了关于规范关联交易和避免资金占用的承诺。</data>
      <data key="d3">chunk-450f069284fc5692d5ade6bb4aeb0deb</data>
