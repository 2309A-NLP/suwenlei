      <data key="d1">artifact</data>
      <data key="d2">验收证明是总体单位或集成商在系统验收后出具的文件，用于发行人确认销售收入。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
      <data key="d4">unknown_source</data>
