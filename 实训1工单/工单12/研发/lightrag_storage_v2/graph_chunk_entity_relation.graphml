    <node id="网络投票平台">
      <data key="d0">网络投票平台</data>
      <data key="d1">method</data>
      <data key="d2">网络投票平台是公司优先提供的现代信息技术手段，用于为股东参加股东大会提供便利。</data>
      <data key="d3">chunk-63e5d2afa2bb086b998b098937fd536f</data>
