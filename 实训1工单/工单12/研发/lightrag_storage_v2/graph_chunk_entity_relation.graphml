    </node>
    <node id="Other Comprehensive Income">
      <data key="d0">Other Comprehensive Income</data>
      <data key="d1">concept</data>
      <data key="d2">Other comprehensive income includes items of income and expense that are not recognized in profit or loss as required or permitted by accounting standards.</data>
      <data key="d3">chunk-715426c8536b679514108da2caab6b17</data>
      <data key="d4">unknown_source</data>
