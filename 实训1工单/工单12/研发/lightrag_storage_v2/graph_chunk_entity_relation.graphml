      <data key="d1">event</data>
      <data key="d2">初始确认日是公司比较金融工具违约风险的基准时点。</data>
      <data key="d3">chunk-36712d9113d14632f0fb71d06e864ed6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277869</data>
