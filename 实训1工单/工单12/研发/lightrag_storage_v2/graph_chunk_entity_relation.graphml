    <node id="Expected Credit Loss">
      <data key="d0">Expected Credit Loss</data>
      <data key="d1">concept</data>
      <data key="d2">Expected credit loss is the amount of loss estimated over the entire lifetime of accounts receivable, used to determine bad debt provisions.</data>
      <data key="d3">chunk-2aa3063ca8148fef0d6b0b98a6b6e563</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277829</data>
