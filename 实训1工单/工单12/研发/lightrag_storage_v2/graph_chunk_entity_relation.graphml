      <data key="d0">Subsidiary</data>
      <data key="d1">organization</data>
      <data key="d2">A subsidiary is an entity controlled by another entity (the parent).</data>
      <data key="d3">chunk-715426c8536b679514108da2caab6b17</data>
      <data key="d4">unknown_source</data>
