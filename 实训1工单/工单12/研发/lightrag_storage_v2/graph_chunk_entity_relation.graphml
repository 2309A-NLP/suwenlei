    <node id="低值易耗品">
      <data key="d0">低值易耗品</data>
      <data key="d1">concept</data>
      <data key="d2">低值易耗品是价值较低的消耗性物品，按照一次转销法进行摊销。</data>
      <data key="d3">chunk-e0d0ee3d0d23d40d115272270f54f621</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277860</data>
