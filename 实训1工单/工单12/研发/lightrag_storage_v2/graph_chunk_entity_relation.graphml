    <node id="信息防护能力">
      <data key="d0">信息防护能力</data>
      <data key="d1">concept</data>
      <data key="d2">信息防护能力是国防指挥信息系统的要素之一，保护网络不受敌方干扰和利用。</data>
      <data key="d3">chunk-953a39fa41a80653a06efc40f9ac9543</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276263</data>
      <data key="d6" />
    </node>
    <node id="进攻性信息作战能力">
      <data key="d0">进攻性信息作战能力</data>
      <data key="d1">concept</data>
      <data key="d2">进攻性信息作战能力是国防指挥信息系统的要素之一，能够对敌方信息系统进行渗透和操纵。</data>
      <data key="d3">chunk-953a39fa41a80653a06efc40f9ac9543</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276263</data>
