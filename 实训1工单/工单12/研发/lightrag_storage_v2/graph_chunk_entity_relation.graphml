    <node id="2006-2020年国家信息化发展战略">
      <data key="d0">2006-2020年国家信息化发展战略</data>
      <data key="d1">content</data>
      <data key="d2">《2006-2020年国家信息化发展战略》由中共中央办公厅、国务院办公厅发布，提出到2020年实现综合信息基础设施基本普及、信息技术自主创新能力显著增强、信息产业结构全面优化、国家信息安全保障水平大幅提高等目标。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
      <data key="d6" />
    </node>
    <node id="中共中央办公厅">
      <data key="d0">中共中央办公厅</data>
      <data key="d1">organization</data>
      <data key="d2">中共中央办公厅参与发布《2006-2020年国家信息化发展战略》。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
      <data key="d6" />
    </node>
    <node id="国务院办公厅">
      <data key="d0">国务院办公厅</data>
      <data key="d1">organization</data>
      <data key="d2">国务院办公厅参与发布《2006-2020年国家信息化发展战略》。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
      <data key="d6" />
    </node>
    <node id="信息系统集成及服务资质认定管理办法(暂行)">
      <data key="d0">信息系统集成及服务资质认定管理办法(暂行)</data>
      <data key="d1">content</data>
      <data key="d2">《信息系统集成及服务资质认定管理办法(暂行)》由中国电子信息行业联合会发布，旨在加强行业自律，维护市场秩序，保障项目质量和信息安全，促进企业能力提高，推动行业健康发展。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
      <data key="d6" />
    </node>
    <node id="中国电子信息行业联合会">
      <data key="d0">中国电子信息行业联合会</data>
      <data key="d1">organization</data>
      <data key="d2">中国电子信息行业联合会是电子信息行业的全国性社会团体，促进自律和行业健康发展。&lt;SEP&gt;中国电子信息行业联合会发布《信息系统集成及服务资质认定管理办法(暂行)》。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-6f59a37440ab95ef90b5519bda697b22</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
      <data key="d6" />
    </node>
    <node id="国家信息化发展战略纲要">
      <data key="d0">国家信息化发展战略纲要</data>
      <data key="d1">content</data>
      <data key="d2">《国家信息化发展战略纲要》由中共中央、国务院发布，提出推进物联网设施建设、优化数据中心布局、加强大数据、云计算、宽带网络协同发展、完善信息基础设施、构建信息安全防御体系等。&lt;SEP&gt;《国家信息化发展战略纲要》是2016年出台的民用领域政策文件。&lt;SEP&gt;A policy document from July 2016 that calls for accelerating information-based military strengthening and building a modern military force system.</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-8612b7b1b05a28fa57b957d874cafa2a&lt;SEP&gt;chunk-80c8729f934676759d234e698f1b535f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780280215</data>
      <data key="d6" />
    </node>
    <node id="中共中央">
      <data key="d0">中共中央</data>
      <data key="d1">organization</data>
      <data key="d2">中共中央参与发布《国家信息化发展战略纲要》。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
      <data key="d6" />
    </node>
    <node id="物联网设施建设">
      <data key="d0">物联网设施建设</data>
      <data key="d1">concept</data>
      <data key="d2">物联网设施建设是《国家信息化发展战略纲要》中提出的措施之一。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
      <data key="d6" />
    </node>
    <node id="数据中心布局">
      <data key="d0">数据中心布局</data>
      <data key="d1">concept</data>
      <data key="d2">数据中心布局优化是《国家信息化发展战略纲要》中提出的措施之一。&lt;SEP&gt;数据中心布局是指优化数据中心的地理分布和资源配置，以提升整体服务能力。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-3104b9748246bf1c1b596137af31103a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="大数据">
      <data key="d0">大数据</data>
      <data key="d1">concept</data>
      <data key="d2">大数据是《国家信息化发展战略纲要》中提到的需要加强协同发展的技术领域。&lt;SEP&gt;大数据是一种需要新处理模式才能具有更强的决策力、洞察发现力和流程优化能力的海量、高增长率和多样化的信息资产。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-3104b9748246bf1c1b596137af31103a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="云计算">
      <data key="d0">云计算</data>
      <data key="d1">concept</data>
      <data key="d2">云计算是《国家信息化发展战略纲要》中提到的需要加强协同发展的技术领域。&lt;SEP&gt;云计算是一种基于互联网的计算方式，通过共享软硬件资源和信息按需提供给计算机和其他设备。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-3104b9748246bf1c1b596137af31103a&lt;SEP&gt;chunk-5df5eb65d2e03b5a130aea62b62f281f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="宽带网络">
      <data key="d0">宽带网络</data>
      <data key="d1">concept</data>
      <data key="d2">宽带网络是《国家信息化发展战略纲要》中提到的需要加强协同发展的基础设施。&lt;SEP&gt;宽带网络是指具有高数据传输速率和始终在线特性的网络接入技术。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-3104b9748246bf1c1b596137af31103a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="应用基础设施服务能力">
      <data key="d0">应用基础设施服务能力</data>
      <data key="d1">concept</data>
      <data key="d2">应用基础设施服务能力是《国家信息化发展战略纲要》中提出的需要增强的目标。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="科研信息化基础设施">
      <data key="d0">科研信息化基础设施</data>
      <data key="d1">concept</data>
      <data key="d2">科研信息化基础设施是《国家信息化发展战略纲要》中提出的需要建设覆盖全国、资源共享的基础设施。&lt;SEP&gt;科研信息化基础设施是指覆盖全国、资源共享的用于支持科学研究的网络、计算和数据资源平台。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-3104b9748246bf1c1b596137af31103a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="信息基础设施">
      <data key="d0">信息基础设施</data>
      <data key="d1">concept</data>
      <data key="d2">信息基础设施是《国家信息化发展战略纲要》中提出的需要完善的基础设施。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="指挥信息系统">
      <data key="d0">指挥信息系统</data>
      <data key="d1">concept</data>
      <data key="d2">指挥信息系统是《国家信息化发展战略纲要》中提出的需要推动集成运用的系统。&lt;SEP&gt;指挥信息系统是用于军事或应急指挥的集成化信息系统，支持决策和行动协调。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-3104b9748246bf1c1b596137af31103a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="信息资源">
      <data key="d0">信息资源</data>
      <data key="d1">concept</data>
      <data key="d2">信息资源是《国家信息化发展战略纲要》中提出的需要加大开发利用力度的资源。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="信息安全防御体系">
      <data key="d0">信息安全防御体系</data>
      <data key="d1">concept</data>
      <data key="d2">信息安全防御体系是《国家信息化发展战略纲要》中提出的需要构建的体系。&lt;SEP&gt;信息安全防御体系是保护信息系统免受攻击、破坏或未经授权访问的综合安全架构。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b&lt;SEP&gt;chunk-3104b9748246bf1c1b596137af31103a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="信息通信行业发展规划">
      <data key="d0">信息通信行业发展规划</data>
      <data key="d1">content</data>
      <data key="d2">《信息通信行业发展规划》是2016年发布的一项规划，具体内容未在文本中完整给出。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="应用基础设施">
      <data key="d0">应用基础设施</data>
      <data key="d1">concept</data>
      <data key="d2">应用基础设施是指支撑各类应用软件运行和服务的底层硬件和软件平台。</data>
      <data key="d3">chunk-3104b9748246bf1c1b596137af31103a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276262</data>
      <data key="d6" />
    </node>
    <node id="信息通信行业发展规划(2016-2020年)">
      <data key="d0">信息通信行业发展规划(2016-2020年)</data>
      <data key="d1">content</data>
      <data key="d2">《信息通信行业发展规划(2016-2020年)》是中国工业和信息化部发布的指导信息通信业未来五年发展的政策文件。&lt;SEP&gt;《信息通信行业发展规划(2016-2020年)》是2017年出台的民用领域政策文件。</data>
      <data key="d3">chunk-3104b9748246bf1c1b596137af31103a&lt;SEP&gt;chunk-8612b7b1b05a28fa57b957d874cafa2a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780278499</data>
      <data key="d6" />
    </node>
    <node id="供给侧结构性改革">
