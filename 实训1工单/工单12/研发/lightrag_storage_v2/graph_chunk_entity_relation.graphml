    <node id="证券服务机构">
      <data key="d0">证券服务机构</data>
      <data key="d1">organization</data>
      <data key="d2">证券服务机构是为本次发行制作、出具文件的机构，承诺对虚假记载、误导性陈述或重大遗漏承担赔偿责任。</data>
      <data key="d3">chunk-3bba9eac029b302aabf1571d3c8bb5ac</data>
