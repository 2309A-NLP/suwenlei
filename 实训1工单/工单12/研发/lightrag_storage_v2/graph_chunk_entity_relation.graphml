      <data key="d0">Vesting Period</data>
      <data key="d1">concept</data>
      <data key="d2">The period during which services must be rendered or performance conditions met before share-based payments become exercisable.</data>
      <data key="d3">chunk-32adcca902f2d818c44b9e6713cc9db6</data>
