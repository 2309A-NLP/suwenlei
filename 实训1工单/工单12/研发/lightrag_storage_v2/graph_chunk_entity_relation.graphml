    <node id="服务能力">
      <data key="d0">服务能力</data>
      <data key="d1">concept</data>
      <data key="d2">服务能力是发行人在选择集成商时考量的因素，包括历史合作、项目经验和业内知名度。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
