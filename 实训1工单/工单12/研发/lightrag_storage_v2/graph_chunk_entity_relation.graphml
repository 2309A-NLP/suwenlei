    <node id="Credit Risk Characteristics">
      <data key="d0">Credit Risk Characteristics</data>
      <data key="d1">concept</data>
      <data key="d2">Credit risk characteristics are the features of accounts receivable used by management to assess and measure expected credit losses.</data>
      <data key="d3">chunk-2aa3063ca8148fef0d6b0b98a6b6e563</data>
      <data key="d4">unknown_source</data>
