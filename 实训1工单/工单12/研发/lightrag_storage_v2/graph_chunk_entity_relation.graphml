    <node id="目标检测与跟踪联合优化技术">
      <data key="d0">目标检测与跟踪联合优化技术</data>
      <data key="d1">method</data>
      <data key="d2">目标检测与跟踪联合优化技术通过实现模块间的信息共享，设计联合优化目标与学习方法，实现端到端的目标检测与跟踪，达到理想的跟踪性能。</data>
      <data key="d3">chunk-b39e1a4c83ac14c523892157386c1a4d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277860</data>
