      <data key="d0">自主创新</data>
      <data key="d1">concept</data>
      <data key="d2">自主创新是指依靠自身力量进行的技术或产品创新。</data>
      <data key="d3">chunk-b84096a6e6d9f55493f1531e413c38d0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277829</data>
