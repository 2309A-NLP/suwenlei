    <node id="AAC">
      <data key="d0">AAC</data>
      <data key="d1">concept</data>
      <data key="d2">AAC是一种高级音频编码，基于MPEG-2的音频编码技术，由多家公司共同开发。&lt;SEP&gt;AAC是一种音频标准，被视音频综合服务平台兼容。</data>
      <data key="d3">chunk-014987a28aa1c57e58428f91364dc2ca&lt;SEP&gt;chunk-4d3373fcf196abd13ecb0324900615ac</data>
      <data key="d4">unknown_source</data>
