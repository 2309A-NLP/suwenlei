    <node id="哑铃型经营方式">
      <data key="d0">哑铃型经营方式</data>
      <data key="d1">concept</data>
      <data key="d2">哑铃型经营方式is a business model focusing on front-end R&amp;D and end-customer sales, with limited in-house production.</data>
      <data key="d3">chunk-3b606597aae507436e4bc3368049cab2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="供应商选择对比表">
      <data key="d0">供应商选择对比表</data>
      <data key="d1">artifact</data>
      <data key="d2">供应商选择对比表is a supplier comparison table used to evaluate and select suppliers.</data>
      <data key="d3">chunk-3b606597aae507436e4bc3368049cab2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="中国国防建设">
      <data key="d0">中国国防建设</data>
      <data key="d1">concept</data>
      <data key="d2">中国国防建设是指中国为维护国家主权和领土完整而进行的军事能力建设，其需求正在逐步提升。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="中国军费">
      <data key="d0">中国军费</data>
      <data key="d1">data</data>
      <data key="d2">中国军费是指中国用于国防的财政支出，预期未来5-10年内将保持稳健增长。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="军品">
      <data key="d0">军品</data>
      <data key="d1">artifact</data>
      <data key="d2">军品是指用于军事目的的产品，其生产研制难度大、周期长，且对供应商有严苛要求。&lt;SEP&gt;军品是列装后融入国防体系的军事产品，需要供应商持续维护、升级、更新，以保障国防体系安全和军队战斗力。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818&lt;SEP&gt;chunk-f24df38475c78597e2425c954a91f189</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780278515</data>
      <data key="d6" />
    </node>
    <node id="武器装备科研生产许可">
      <data key="d0">武器装备科研生产许可</data>
      <data key="d1">concept</data>
      <data key="d2">武器装备科研生产许可是国家对军工行业实行的许可制度，兴图新科已取得该许可，能够从事武器装备科研生产任务。&lt;SEP&gt;武器装备科研生产许可是中国对军品生产企业实行的许可制度，未获得许可的企业不得从事相关生产活动。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818&lt;SEP&gt;chunk-30d373540c8eeaa2735aface7c899501</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="视频监控及其他领域">
      <data key="d0">视频监控及其他领域</data>
      <data key="d1">concept</data>
      <data key="d2">视频监控及其他领域是电子信息系统的一个应用领域，其经营模式以订单式销售为主，具有定制化特征。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="政府">
      <data key="d0">政府</data>
      <data key="d1">organization</data>
      <data key="d2">政府是视频监控系统等产品的最终用户之一，其采购具有严格的预算和流程管理制度。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="大型企业单位">
      <data key="d0">大型企业单位</data>
      <data key="d1">organization</data>
      <data key="d2">大型企业单位是视频监控系统等产品的最终用户之一，其采购具有严格的预算和流程管理制度。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="军品配套生产商">
      <data key="d0">军品配套生产商</data>
      <data key="d1">organization</data>
      <data key="d2">军品配套生产商是从事军工装备制造的企业，其产品事关国防安全，需要大量前期投入。</data>
      <data key="d3">chunk-fb617c7dd4c80f8f2ee8c9dbb4f4b818</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="产品授权书">
      <data key="d0">产品授权书</data>
      <data key="d1">artifact</data>
      <data key="d2">产品授权书是发行人出具给集成商的文件，授权其投标文件使用发行人的产品及参数。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="专用服务器">
      <data key="d0">专用服务器</data>
      <data key="d1">artifact</data>
      <data key="d2">专用服务器是用于部署公司自研软件的硬件设备，形成嵌入式硬件产品。&lt;SEP&gt;专用服务器是视频指挥系统的核心设备之一，由发行人向集成商供应。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37&lt;SEP&gt;chunk-58ff3d604c1665714873af9d99479266</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276282</data>
      <data key="d6" />
    </node>
    <node id="非军方客户">
      <data key="d0">非军方客户</data>
      <data key="d1">organization</data>
      <data key="d2">非军方客户是发行人的客户群体，直接签署采购协议购买设备。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276283</data>
      <data key="d6" />
    </node>
    <node id="销售部">
      <data key="d0">销售部</data>
      <data key="d1">organization</data>
      <data key="d2">销售部是公司内部负责获取客户需求并协同产品部形成物料清单的部门。&lt;SEP&gt;销售部是公司内部部门，负责获取项目信息和组织销售活动。&lt;SEP&gt;销售部是发行人内部部门，负责项目信息获取和立项审批。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37&lt;SEP&gt;chunk-88b3d1c3a20dfbb1aa241c83ed13bf48&lt;SEP&gt;chunk-58ff3d604c1665714873af9d99479266</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276283</data>
      <data key="d6" />
    </node>
    <node id="嵌入式硬件">
      <data key="d0">嵌入式硬件</data>
      <data key="d1">artifact</data>
      <data key="d2">嵌入式硬件是发行人单独销售的设备之一，用于维修保障或系统扩展。&lt;SEP&gt;嵌入式硬件是公司单独销售的设备，用于原有系统的扩展或维修。&lt;SEP&gt;嵌入式硬件是兴图新科开发的专用型硬件，包括编码设备、解码设备、服务设备、终端设备，用于实现视频指挥、视频会议等业务功能。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37&lt;SEP&gt;chunk-88b3d1c3a20dfbb1aa241c83ed13bf48&lt;SEP&gt;chunk-fb4d8cf35df3e1392a2369c7ae82c4af</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277856</data>
      <data key="d6" />
    </node>
    <node id="配套硬件">
      <data key="d0">配套硬件</data>
      <data key="d1">artifact</data>
      <data key="d2">配套硬件是发行人单独销售的设备之一，用于维修保障或系统扩展。&lt;SEP&gt;配套硬件是公司单独销售的设备，用于系统配套。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37&lt;SEP&gt;chunk-88b3d1c3a20dfbb1aa241c83ed13bf48</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276283</data>
      <data key="d6" />
    </node>
    <node id="软件">
      <data key="d0">软件</data>
      <data key="d1">artifact</data>
      <data key="d2">软件是发行人单独销售的产品之一，通常与硬件设备配套使用。&lt;SEP&gt;软件是无形资产类别，摊销年限为3-10年，采用直线法或预期实现方式摊销。&lt;SEP&gt;软件refers to the software components sold by the company, either separately or as part of embedded products.&lt;SEP&gt;软件is an intangible asset of武汉兴图新科电子股份有限公司with a book value of 39.41万元as of June 30, 2019.&lt;SEP&gt;软件refers to software provided by the company to direct military clients.&lt;SEP&gt;软件is an intangible asset acquired through external purchase, with recorded original value, accumulated amortization, and book value.</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37&lt;SEP&gt;chunk-662e7d9b9eb2689b664f1c99bb66d9b7&lt;SEP&gt;chunk-ce08b9b593552ede2d4c6210b4c2011c&lt;SEP&gt;chunk-eb7b1f3636d566f3ce04064fc78b9394&lt;SEP&gt;chunk-eee2c091e44ba62cc1d372bad97085a7&lt;SEP&gt;chunk-d85045625dc6dfb91844c0426117918a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780279671</data>
      <data key="d6" />
    </node>
    <node id="招投标">
      <data key="d0">招投标</data>
      <data key="d1">event</data>
      <data key="d2">招投标是发行人获取订单的方式之一，用于军方客户和非军方客户的项目。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276283</data>
      <data key="d6" />
    </node>
    <node id="竞标">
      <data key="d0">竞标</data>
      <data key="d1">event</data>
      <data key="d2">竞标是发行人获取订单的方式之一，用于民用领域和集成商合作项目。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276283</data>
      <data key="d6" />
    </node>
    <node id="谈判">
      <data key="d0">谈判</data>
      <data key="d1">method</data>
      <data key="d2">谈判是发行人与集成商合作中确定合作条件和回款进度的方式。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276283</data>
      <data key="d6" />
    </node>
    <node id="预收款项">
      <data key="d0">预收款项</data>
      <data key="d1">data</data>
      <data key="d2">预收款项是发行人与集成商合同中约定的款项，用于缓解资金占用压力。&lt;SEP&gt;Advances from customers, a current liability item on the balance sheet, with amounts listed for various dates.</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37&lt;SEP&gt;chunk-507e2b6ca2f473187fea2747ef444ec5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277843</data>
      <data key="d6" />
    </node>
    <node id="物料清单">
      <data key="d0">物料清单</data>
      <data key="d1">data</data>
      <data key="d2">物料清单是产品部形成的文件，用于指导商务部的备货和采购。</data>
      <data key="d3">chunk-0099d5a68aa2a54c0a612a238ad5ba37&lt;SEP&gt;chunk-88b3d1c3a20dfbb1aa241c83ed13bf48&lt;SEP&gt;chunk-58ff3d604c1665714873af9d99479266</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276283</data>
      <data key="d6" />
    </node>
