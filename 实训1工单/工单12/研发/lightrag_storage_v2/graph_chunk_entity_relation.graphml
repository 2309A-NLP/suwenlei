    <node id="战略投资者">
      <data key="d0">战略投资者</data>
      <data key="d1">person</data>
      <data key="d2">战略投资者是符合资格并参与本次发行定向配售的投资者。</data>
      <data key="d3">chunk-cb54c5118e1ed95515ee7fc4eb482abd</data>
      <data key="d4">unknown_source</data>
