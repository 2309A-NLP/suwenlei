    <node id="股利分配政策">
      <data key="d0">股利分配政策</data>
      <data key="d1">concept</data>
      <data key="d2">The股利分配政策is the company's policy on distributing profits to shareholders, including cash and stock dividends.</data>
      <data key="d3">chunk-735c1e7025b476d06d2968a85d58fc1d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780280181</data>
