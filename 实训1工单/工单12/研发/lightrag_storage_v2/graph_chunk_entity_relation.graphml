    <node id="Historical Credit Loss Experience">
      <data key="d0">Historical Credit Loss Experience</data>
      <data key="d1">data</data>
      <data key="d2">Historical credit loss experience is past data used as a reference for estimating expected credit losses, adjusted for forward-looking estimates.</data>
      <data key="d3">chunk-2aa3063ca8148fef0d6b0b98a6b6e563</data>
      <data key="d4">unknown_source</data>
