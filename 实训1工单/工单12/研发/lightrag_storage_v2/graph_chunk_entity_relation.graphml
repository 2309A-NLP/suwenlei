    <node id="面向微服务的视音频中间件">
      <data key="d0">面向微服务的视音频中间件</data>
      <data key="d1">concept</data>
      <data key="d2">面向微服务的视音频中间件是兴图新科采用的技术架构，用于构建其软件系统。</data>
      <data key="d3">chunk-b39e1a4c83ac14c523892157386c1a4d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277860</data>
