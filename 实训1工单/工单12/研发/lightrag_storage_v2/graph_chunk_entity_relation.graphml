    <node id="Software Development Department">
      <data key="d0">Software Development Department</data>
      <data key="d1">organization</data>
      <data key="d2">The Software Development Department undertakes code development tasks from other departments, focusing on code quality to ensure delivered code meets company requirements. It also performs routine code reuse and software version upgrades.</data>
      <data key="d3">chunk-b810ef07f1562ed37e767bba89672005</data>
