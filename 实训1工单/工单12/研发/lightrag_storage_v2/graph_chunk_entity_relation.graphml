    <node id="H.26X">
      <data key="d0">H.26X</data>
      <data key="d1">concept</data>
      <data key="d2">H.26X是一系列音视频压缩编码技术标准，主要包括H.264、H.265等。</data>
      <data key="d3">chunk-014987a28aa1c57e58428f91364dc2ca</data>
