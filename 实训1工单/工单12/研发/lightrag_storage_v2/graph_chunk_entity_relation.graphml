    <node id="专用服务器设备">
      <data key="d0">专用服务器设备</data>
      <data key="d1">artifact</data>
      <data key="d2">专用服务器设备是搭载视音频综合服务平台的核心设备，为系统提供视音频资源管理、接入、调度、转发、录像与流化回放、联网组网等综合服务。</data>
      <data key="d3">chunk-7a439299f90cd269df576a65e3aec0bd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780275802</data>
