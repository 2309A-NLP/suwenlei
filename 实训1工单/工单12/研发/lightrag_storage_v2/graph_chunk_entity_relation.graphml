      <data key="d1">concept</data>
      <data key="d2">电子对抗是国防信息化中的重点建设领域之一。</data>
      <data key="d3">chunk-781a874dfa08b29a9052bcfdfde2061b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780276261</data>
