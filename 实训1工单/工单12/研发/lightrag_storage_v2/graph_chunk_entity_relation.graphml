    <node id="Financial Asset">
      <data key="d0">Financial Asset</data>
      <data key="d1">concept</data>
      <data key="d2">A financial asset is a non-physical asset whose value is derived from a contractual claim, such as cash, equity instruments, or a contractual right to receive cash.</data>
      <data key="d3">chunk-715426c8536b679514108da2caab6b17</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277843</data>
