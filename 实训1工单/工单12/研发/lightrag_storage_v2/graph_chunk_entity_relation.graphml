      <data key="d6" />
    </node>
    <node id="电子设备">
      <data key="d0">电子设备</data>
      <data key="d1">artifact</data>
      <data key="d2">电子设备是固定资产类别，采用年限平均法折旧，折旧年限为3-5年，残值率5%，年折旧率19.00-31.67%。&lt;SEP&gt;电子设备is a category of fixed assets owned by the company.</data>
      <data key="d3">chunk-662e7d9b9eb2689b664f1c99bb66d9b7&lt;SEP&gt;chunk-cc250dce92b40961347f8667cb257c01</data>
