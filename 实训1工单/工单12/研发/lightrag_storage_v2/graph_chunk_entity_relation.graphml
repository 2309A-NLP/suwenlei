      <data key="d0">关联交易管理制度</data>
      <data key="d1">concept</data>
      <data key="d2">The related party transaction management system is a set of rules established to regulate and reduce related party transactions.</data>
      <data key="d3">chunk-e33d1b358ec992265a4a1fbb025624f1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277863</data>
      <data key="d6" />
    </node>
    <node id="终止经营净利润">
      <data key="d0">终止经营净利润</data>
      <data key="d1">concept</data>
      <data key="d2">终止经营净利润is the net profit from discontinued operations, reported as zero for all periods.</data>
      <data key="d3">chunk-66bf9577dcccaac7aa541c5650962f89</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277863</data>
