    <node id="微服务资源池">
      <data key="d0">微服务资源池</data>
      <data key="d1">concept</data>
      <data key="d2">微服务资源池是兴图新科微服务视音频中间件之上提供的可复用微服务集合，业务系统可根据需求选择特定微服务进行编排和组态。</data>
      <data key="d3">chunk-a04f7cc168a67cb2584f5cf93f3f9ab8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780277860</data>
      <data key="d6" />
    </node>
