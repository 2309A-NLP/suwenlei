      <data key="d1">event</data>
      <data key="d2">股价稳定方案公告是公司发布稳定股价方案的正式通知，标志着方案开始实施。</data>
      <data key="d3">chunk-2418430c4d63d444240019e825101c4e</data>
      <data key="d4">unknown_source</data>
