    <node id="公司发展阶段">
      <data key="d0">公司发展阶段</data>
      <data key="d1">concept</data>
      <data key="d2">公司发展阶段包括成熟期和成长期，影响现金分红比例的最低要求。</data>
      <data key="d3">chunk-9c007f1fc740ba4fcb6bf207b57f3a15</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780280209</data>
      <data key="d6" />
    </node>
    <node id="可分配利润">
      <data key="d0">可分配利润</data>
      <data key="d1">concept</data>
      <data key="d2">可分配利润是公司用于利润分配的税后利润，现金分红应不低于其10%。</data>
      <data key="d3">chunk-9c007f1fc740ba4fcb6bf207b57f3a15</data>
